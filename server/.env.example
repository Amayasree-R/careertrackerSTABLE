# ============================================
# Career Tracker Server - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# DATABASE
# ============================================
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/databasename
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/careertracker?retryWrites=true&w=majority

# ============================================
# AUTHENTICATION
# ============================================
# Secret key for JWT token signing - use a long random string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random_at_least_32_chars

# ============================================
# AI SERVICES
# ============================================
# Groq API Key - Required for certificate analysis and quiz generation
# Get your API key from: https://console.groq.com/keys
# Format: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# Optional: Google Generative AI (Gemini)
GOOGLE_GENERATIVE_AI_KEY=your_google_ai_key_here

# Optional: Cerebras AI
CEREBRAS_API_KEY=your_cerebras_api_key_here

# ============================================
# EXTERNAL APIs (Optional)
# ============================================
# GitHub Personal Access Token - for fetching user repositories
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_token_here

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. Never commit the .env file to version control
# 2. Keep all API keys secret - they are production credentials
# 3. The .env.example file can be safely committed as it contains placeholder values
# 4. Never log or print actual API keys
# 5. Rotate API keys regularly for security
# 6. Use different keys for development, staging, and production environments
